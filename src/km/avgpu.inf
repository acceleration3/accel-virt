; provision.ps1 names host GPUs from C:\av\adapters.txt; the lines it adds end with "; provision.ps1: a host GPU".

[Version]
Signature   = "$Windows NT$"
Class       = Display
ClassGuid   = {4d36e968-e325-11ce-bfc1-08002be10318}
Provider    = %Provider%
DriverVer   = 09/11/2026,0.35.0.0
CatalogFile = avgpu.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13
Avgpu_Vendor64 = 11
Avgpu_Vendor32 = 10,SysWOW64

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
avgpu.sys = 1
avvk.dll = 1
avvk.json = 1
avgl.dll = 1
avcl.dll = 1
avumd.dll = 1
avvk32.dll = 1
avvk32.json = 1
avgl32.dll = 1
avcl32.dll = 1
avumd32.dll = 1
atiadlxx.dll = 1
nvapi64.dll = 1
atiadlxy.dll = 1
nvapi.dll = 1

[Manufacturer]
%Provider% = Avgpu, NTamd64.10.0...26100

[Avgpu.NTamd64.10.0...26100]
%DeviceName% = Avgpu_Install, PCI\VEN_1AF4&DEV_1050&SUBSYS_52561AF4

[Avgpu_Install]
FeatureScore = F8
CopyFiles    = Avgpu_Files, Avgpu_Vendor64, Avgpu_Vendor32
AddReg       = Avgpu_SoftwareSettings, Avgpu_Scheduler

[Avgpu_Scheduler]
HKLM, System\CurrentControlSet\Control\GraphicsDrivers\Scheduler, EnablePreemption, 0x00010001, 0

[Avgpu_SoftwareSettings]
HKR,, UserModeDriverName, 0x00010000, "%13%\avumd.dll", "%13%\avumd.dll", "%13%\avumd.dll", "%13%\avumd.dll"
HKR,, VulkanDriverName, 0x00010000, "%13%\avvk.json"
HKR,, OpenGLDriverName, 0x00010000, "%13%\avgl.dll"
HKR,, OpenGLVersion, 0x00010001, 2
HKR,, OpenGLFlags, 0x00010001, 1
HKR,, OpenCLDriverName, 0x00000000, "%13%\avcl.dll"
HKR,, UserModeDriverNameWow, 0x00010000, "%13%\avumd32.dll", "%13%\avumd32.dll", "%13%\avumd32.dll", "%13%\avumd32.dll"
HKR,, VulkanDriverNameWow, 0x00010000, "%13%\avvk32.json"
HKR,, OpenGLDriverNameWow, 0x00010000, "%13%\avgl32.dll"
HKR,, OpenGLVersionWow, 0x00010001, 2
HKR,, OpenGLFlagsWow, 0x00010001, 1
HKR,, OpenCLDriverNameWow, 0x00000000, "%13%\avcl32.dll"
HKR, Features\4, Enabled, 0x00010001, 1
HKR, Features\4, AllowExperimental, 0x00010001, 1
HKR, Features\37, Enabled, 0x00010001, 1
HKR, Features\37, AllowExperimental, 0x00010001, 1

[Avgpu_Files]
avgpu.sys
avvk.dll
avvk.json
avgl.dll
avcl.dll
avumd.dll
avvk32.dll
avvk32.json
avgl32.dll
avcl32.dll
avumd32.dll

[Avgpu_Vendor64]
atiadlxx.dll
nvapi64.dll

[Avgpu_Vendor32]
atiadlxy.dll
nvapi.dll

[Avgpu_Install.HW]
AddReg = Avgpu_Interrupts

[Avgpu_Interrupts]
HKR, "Interrupt Management", 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MSISupported, 0x00010001, 1
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MessageNumberLimit, 0x00010001, 11

[Avgpu_Install.Services]
AddService = avgpu, 0x00000002, Avgpu_Service

[Avgpu_Service]
DisplayName   = %ServiceName%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\avgpu.sys

[Strings]
Provider    = "accel-virt"
DiskName    = "accel-virt driver package"
DeviceName  = "accel-virt paravirtual GPU"
ServiceName = "accel-virt WDDM display miniport"
