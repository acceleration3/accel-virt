# The device core the patched QEMU links into its virtio-gpu-rvk module
# (tools/build_qemu.sh). Generated by CMake into the build tree.
Name: rvk_device
Description: accel-virt virtio-gpu-rvk device core, behind the C ABI in rvk_device.h
Version: 0.1.0
Cflags: -I@CMAKE_SOURCE_DIR@/src/device/abi
Libs: $<TARGET_FILE:rvk_device>
