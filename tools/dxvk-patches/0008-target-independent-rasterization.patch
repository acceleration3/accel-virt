       D3D11ShaderType::eVertex, D3D11ShaderType::eGeometry,
       D3D11ShaderType::eHull,   D3D11ShaderType::eDomain,
       D3D11ShaderType::ePixel);
@@ -4837,6 +4953,9 @@ namespace dxvk {
 
