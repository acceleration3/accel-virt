From: accel-virt
Subject: [PATCH] a dma-buf is imported only as the types it lists and the heap names

accel-virt: NVIDIA does not survive refused imports (after about four, every allocation and export of the process fails), so an import is never tried into a type the dma-buf does not list. Only the listed types the heap names are tried; a listed type it does not name would be memory the pages cannot be read back through.
---
diff --git a/libs/vkd3d/memory.c b/libs/vkd3d/memory.c
index 2f4aa06..ee6a3de 100644
--- a/libs/vkd3d/memory.c
+++ b/libs/vkd3d/memory.c
@@ -1259,7 +1259,7 @@ static HRESULT vkd3d_import_fd_memory(struct d3d12_device *device, int fd,
 #else
     const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
     VkMemoryFdPropertiesKHR fd_properties;
-    uint32_t untried;
+    uint32_t untried, first, pass;
     HRESULT hr;
 
     if (!device->vk_info.KHR_external_memory_fd || !device->vk_info.EXT_external_memory_dma_buf)
@@ -1271,26 +1271,22 @@ static HRESULT vkd3d_import_fd_memory(struct d3d12_device *device, int fd,
             VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, fd, &fd_properties)) != VK_SUCCESS)
         return E_INVALIDARG;
 
-    if (SUCCEEDED(hr = vkd3d_import_fd_attempt(device, fd, size, type_flags,
-            type_mask & fd_properties.memoryTypeBits, pNext, allocation)))
-        return hr;
+    /* Only the types the dma-buf lists are tried: NVIDIA does not survive refused imports, after a few of them every
+     * allocation of the process fails. */
+    untried = fd_properties.memoryTypeBits & ((1u << device->memory_properties.memoryTypeCount) - 1u);
+    first = untried & type_mask;
 
-    untried = type_mask & ((1u << device->memory_properties.memoryTypeCount) - 1u);
-    while (untried)
+    for (pass = 0; pass < 1; pass++)
     {
-        uint32_t type_index = vkd3d_bitmask_iter32(&untried);
+        uint32_t candidates = first;
 
-        if (SUCCEEDED(hr = vkd3d_import_fd_attempt(device, fd, size, 0, 1u << type_index, pNext, allocation)))
-            return hr;
-    }
-
-    untried = fd_properties.memoryTypeBits & ~type_mask & ((1u << device->memory_properties.memoryTypeCount) - 1u);
-    while (untried)
-    {
-        uint32_t type_index = vkd3d_bitmask_iter32(&untried);
+        while (candidates)
+        {
+            uint32_t type_index = vkd3d_bitmask_iter32(&candidates);
 
-        if (SUCCEEDED(hr = vkd3d_import_fd_attempt(device, fd, size, 0, 1u << type_index, pNext, allocation)))
-            return hr;
+            if (SUCCEEDED(hr = vkd3d_import_fd_attempt(device, fd, size, 0, 1u << type_index, pNext, allocation)))
+                return hr;
+        }
     }
 
     WARN("Failed to import dma-buf memory, hr %#x, memory types %#x of %#x.\n",
