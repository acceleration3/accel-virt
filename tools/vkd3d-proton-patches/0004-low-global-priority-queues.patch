--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -1417,7 +1417,7 @@ static HRESULT vkd3d_instance_init(struct vkd3d_instance *instance,
 
     TRACE("Application: %s.\n", debugstr_a(application_info.pApplicationName));
 
