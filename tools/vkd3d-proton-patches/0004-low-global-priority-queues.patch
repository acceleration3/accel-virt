+            queue_priorities[i].globalPriority = VK_QUEUE_GLOBAL_PRIORITY_LOW_KHR;
+            device_queue_info.vk_queue_create_info[i].pNext = &queue_priorities[i];
+        }
+        extensions[device_info.enabledExtensionCount++] = VK_KHR_GLOBAL_PRIORITY_EXTENSION_NAME;
+    }
+
     vr = VK_CALL(vkCreateDevice(physical_device, &device_info, NULL, &vk_device));
+    if (vr < 0 && low_priority)
+    {
+        for (i = 0; i < device_info.queueCreateInfoCount; i++)
+            device_queue_info.vk_queue_create_info[i].pNext = NULL;
+        device_info.enabledExtensionCount = original_extension_count;
+        vr = VK_CALL(vkCreateDevice(physical_device, &device_info, NULL, &vk_device));
+    }
     if (vr == VK_ERROR_INITIALIZATION_FAILED &&
             vkd3d_disable_nvx_extensions(device, extensions, &device_info.enabledExtensionCount))
     {
