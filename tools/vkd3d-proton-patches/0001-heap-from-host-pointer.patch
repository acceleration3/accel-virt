+/* A host pointer and its size, imported as a buffer heap. Unlike
+ * OpenExistingHeapFromAddress this needs no VirtualQuery, so it works natively
+ * too: an embedder that owns a mapping (accel-virt's executor, over guest
+ * memory) names its extent itself. */
+static HRESULT STDMETHODCALLTYPE d3d12_device_OpenExistingHeapFromAddress1(d3d12_device_iface *iface,
+        const void *address, SIZE_T size, REFIID riid, void **heap)
+{
+    struct d3d12_device *device = impl_from_ID3D12Device(iface);
+    struct d3d12_heap *object;
+    D3D12_HEAP_DESC heap_desc;
+    HRESULT hr;
+
+    TRACE("iface %p, address %p, size %#"PRIx64", riid %s, heap %p\n",
+          iface, address, (uint64_t)size, debugstr_guid(riid), heap);
+
+    if (!address || !size)
+        return E_INVALIDARG;
+
+    memset(&heap_desc, 0, sizeof(heap_desc));
+    heap_desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+    heap_desc.Flags = D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS;
+    heap_desc.Properties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_WRITE_BACK;
+    heap_desc.Properties.MemoryPoolPreference = D3D12_MEMORY_POOL_L0;
+    heap_desc.Properties.Type = D3D12_HEAP_TYPE_CUSTOM;
+    heap_desc.Properties.CreationNodeMask = 1;
+    heap_desc.Properties.VisibleNodeMask = 1;
+    heap_desc.SizeInBytes = size;
+
+    if (FAILED(hr = d3d12_heap_create(device, &heap_desc, (void *)address, &object)))
+    {
+        *heap = NULL;
+        return hr;
+    }
+
+    return return_interface(&object->ID3D12Heap_iface, &IID_ID3D12Heap, riid, heap);
+}
+
+HRESULT vkd3d_open_heap_from_dmabuf(ID3D12Device *device, void *address, int fd, UINT64 size,
+        REFIID riid, void **heap)
+{
+    struct d3d12_heap *object;
+    D3D12_HEAP_DESC heap_desc;
+    HRESULT hr;
+
+    if (!device || !heap || !address || fd < 0 || !size)
+        return E_INVALIDARG;
+
+    memset(&heap_desc, 0, sizeof(heap_desc));
+    heap_desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+    heap_desc.Flags = D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS;
+    heap_desc.Properties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_WRITE_BACK;
+    heap_desc.Properties.MemoryPoolPreference = D3D12_MEMORY_POOL_L0;
+    heap_desc.Properties.Type = D3D12_HEAP_TYPE_CUSTOM;
+    heap_desc.Properties.CreationNodeMask = 1;
+    heap_desc.Properties.VisibleNodeMask = 1;
+    heap_desc.SizeInBytes = size;
+
+    if (FAILED(hr = d3d12_heap_create_imported(impl_from_ID3D12Device((d3d12_device_iface *)device),
+            &heap_desc, address, fd, &object)))
+    {
+        *heap = NULL;
+        return hr;
+    }
+    return return_interface(&object->ID3D12Heap_iface, &IID_ID3D12Heap, riid, heap);
+}
